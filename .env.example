# =============================================================================
# Parkinova - Parkinson's MRI Analysis System Configuration
# =============================================================================

# Application Environment (development / production)
APP_ENV=production
DEBUG=False

# Secure Session Secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate_your_secure_secret_key_here

# -----------------------------------------------------------------------------
# Google Sign-In (OAuth 2.0) Configuration
# -----------------------------------------------------------------------------
# To enable Google OAuth 2.0 Sign-In:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a project: "Parkinova Research App"
# 3. Configure OAuth Consent Screen (User Type: Internal / External)
# 4. Create Credentials -> OAuth Client ID -> Web Application
# 5. Add Authorized JavaScript Origins: http://localhost:5000, http://127.0.0.1:5000
# 6. Copy your Client ID and Client Secret below:
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Server Settings (for Mobile Access & Web App)
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
